#!/usr/bin/env bash
# Stop hook — auto-trigger cmux-handoff when context is full AND ready beads work remains.
# Spec: bd sp-dbk. FAIL-OPEN: any missing dep / parse error exits 0 (never traps a session).
PCT="${HANDOFF_CTX_PCT:-0.30}"
STATE_DIR="${HANDOFF_STATE_DIR:-$HOME/.claude/cmux-handoff-state}"
BD_BIN="${BD_BIN:-bd}"
JQ_BIN="${JQ_BIN:-jq}"
HANDOFF_SH="${HANDOFF_SH:-$(cd "$(dirname "$0")/.." 2>/dev/null && pwd)/skills/cmux-handoff/scripts/handoff.sh}"

infer_window() {
  if [ -n "${HANDOFF_CTX_WINDOW:-}" ]; then printf '%s' "$HANDOFF_CTX_WINDOW"; return; fi
  case "$1" in
    *'[1m]'*|*opus-4-6*|*opus-4-7*|*opus-4-8*|*sonnet-4-6*|*fable-5*|*mythos*) printf '1000000' ;;
    *) printf '200000' ;;
  esac
}
last_assistant_usage() {
  "$JQ_BIN" -rs '
    [ .[] | select(.type=="assistant" and (.message.usage != null)) ] as $a
    | if ($a|length)==0 then empty
      else $a[-1].message as $m
        | (($m.usage.input_tokens // 0)+($m.usage.cache_creation_input_tokens // 0)+($m.usage.cache_read_input_tokens // 0)) as $occ
        | "\($m.model // "unknown") \($occ)" end
  ' "$1" 2>/dev/null
}
last_assistant_footer() {
  "$JQ_BIN" -rs '
    [ .[] | select(.type=="assistant" and (.message.content != null)) ] as $a
    | if ($a|length)==0 then empty
      else ($a[-1].message.content | map(select(.type=="text") | .text // "") | join("\n")) end
  ' "$1" 2>/dev/null
}
main() {
  [ "${HANDOFF_DISABLE:-}" = "1" ] && exit 0
  command -v "$JQ_BIN" >/dev/null 2>&1 || exit 0
  command -v "$BD_BIN" >/dev/null 2>&1 || exit 0
  command -v awk >/dev/null 2>&1 || exit 0

  input="$(cat)"; [ -n "$input" ] || exit 0
  [ "$(printf '%s' "$input" | "$JQ_BIN" -r '.stop_hook_active // false' 2>/dev/null)" = "true" ] && exit 0

  session="$(printf '%s' "$input" | "$JQ_BIN" -r '.session_id // empty' 2>/dev/null)"
  transcript="$(printf '%s' "$input" | "$JQ_BIN" -r '.transcript_path // empty' 2>/dev/null)"
  [ -n "$transcript" ] && [ -r "$transcript" ] || exit 0

  flag="$STATE_DIR/${session:-unknown}"
  [ -n "$session" ] && [ -e "$flag" ] && exit 0       # already handed off this session

  footer="$(last_assistant_footer "$transcript")"
  last_line="$(printf '%s\n' "$footer" | awk 'NF{l=$0} END{print l}')"
  case "$last_line" in
    *🔴*|*🟡*) exit 0 ;;   # blocked / ongoing -> keep working, recheck next stop
  esac

  mu="$(last_assistant_usage "$transcript")"; [ -n "$mu" ] || exit 0
  model="${mu% *}"; occ="${mu##* }"
  case "$occ" in ''|*[!0-9]*) exit 0 ;; esac
  window="$(infer_window "$model")"
  awk -v o="$occ" -v w="$window" -v p="$PCT" 'BEGIN{exit !(w>0 && (o/w)>=p)}' || exit 0

  ready="$("$BD_BIN" ready --json 2>/dev/null | "$JQ_BIN" 'length' 2>/dev/null)"
  case "$ready" in ''|*[!0-9]*) exit 0 ;; esac
  [ "$ready" -gt 0 ] || exit 0

  inprog="$("$BD_BIN" list --status in_progress --json 2>/dev/null | "$JQ_BIN" 'length' 2>/dev/null)"
  case "$inprog" in ''|*[!0-9]*) inprog=0 ;; esac     # bd list failed -> treat as clean seam
  [ "$inprog" -eq 0 ] || exit 0                        # mid-task -> wait for a clean seam

  [ -n "$session" ] && mkdir -p "$STATE_DIR" 2>/dev/null
  pct_disp="$(awk -v o="$occ" -v w="$window" 'BEGIN{printf "%d",(o*100)/w}')"
  tk_disp="$(awk -v o="$occ" 'BEGIN{printf "%d",o/1000}')"

  # [C] In cmux with a usable handoff script -> spawn a fresh session directly, no agent round-trip.
  if [ -n "${CMUX_SURFACE_ID:-}" ] && command -v cmux >/dev/null 2>&1 && [ -x "$HANDOFF_SH" ]; then
    rj="$("$BD_BIN" ready --json 2>/dev/null)"
    nid="$(printf '%s' "$rj" | "$JQ_BIN" -r '.[0].id // empty' 2>/dev/null)"
    ntitle="$(printf '%s' "$rj" | "$JQ_BIN" -r '.[0].title // empty' 2>/dev/null)"
    seed="Continue work. Next ready task: ${nid} \"${ntitle}\" — claim it (bd update ${nid} --claim), then do it per its bead body."
    [ -n "$session" ] && : > "$flag" 2>/dev/null
    nohup sh "$HANDOFF_SH" "$seed" >/dev/null 2>&1 &
    exit 0
  fi

  # [A] Fallback: not in cmux -> block and let the agent run cmux-handoff (which has its own non-cmux fallback).
  [ -n "$session" ] && : > "$flag" 2>/dev/null
  printf '{"decision":"block","reason":"Context at %s%% (~%sk tokens), clean 🟢 seam, ready beads remain. Invoke the cmux-handoff skill now (Skill tool: cmux-handoff) and hand off WITHOUT asking for confirmation — this is the automatic hands-free path."}\n' "$pct_disp" "$tk_disp"
  exit 0
}
main
