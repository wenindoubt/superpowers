#!/usr/bin/env bash
# Beads-native counterpart to task-brief: write one task bead's full text to a
# file the implementer reads in one call, so the bead body never has to be
# pasted through the controller's context. This bridges beads (where the plan
# lives, as epic + task beads) to SP6's file-based handoff. review-package is
# unchanged and already beads-agnostic.
#
# Usage: task-brief-bead BEAD_ID [OUTFILE]
# Default OUTFILE: <sdd-workspace>/task-<BEAD_ID>-brief.md
# (per worktree; concurrent runs in the same working tree share the dir).
set -euo pipefail

if [ $# -lt 1 ] || [ $# -gt 2 ]; then
  echo "usage: task-brief-bead BEAD_ID [OUTFILE]" >&2
  exit 2
fi

command -v bd >/dev/null 2>&1 || {
  echo "bd not available — use task-brief with a plan markdown file instead" >&2
  exit 2
}
command -v python3 >/dev/null 2>&1 || {
  echo "python3 required to assemble the brief from the bead JSON" >&2
  exit 2
}

id=$1
if [ $# -eq 2 ]; then
  out=$2
else
  dir=$("$(cd "$(dirname "$0")" && pwd)/sdd-workspace")
  out="$dir/task-${id}-brief.md"
fi

bd show "$id" --json | python3 -c '
import json, sys
d = json.load(sys.stdin)
o = d[0] if isinstance(d, list) else d
parts = ["# " + (o.get("title") or "(untitled)").strip(), ""]
desc = (o.get("description") or "").strip()
if desc:
    parts += [desc, ""]
for label, key in (("Acceptance criteria", "acceptance_criteria"),
                   ("Design", "design"),
                   ("Notes", "notes")):
    v = (o.get(key) or "").strip()
    if v:
        parts += ["## " + label, "", v, ""]
sys.stdout.write("\n".join(parts).rstrip() + "\n")
' > "$out"

if [ ! -s "$out" ]; then
  echo "bead ${id} produced no brief (check: bd show ${id})" >&2
  exit 3
fi

echo "wrote ${out}: $(wc -l < "$out" | tr -d ' ') lines"
